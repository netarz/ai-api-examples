{
  "name": "NetArz AI - chat completion",
  "nodes": [
    {
      "parameters": {},
      "id": "7c1f7a52-1d1e-4a57-9a8e-1f0d3f2b0a01",
      "name": "Manual trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://netarz.ir/api/ai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"max_tokens\": 300,\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"شما دستیار فارسی‌زبان یک فروشگاه هستید. کوتاه جواب بدهید.\"},\n    {\"role\": \"user\", \"content\": \"برای یک فروشگاه لوازم ورزشی یک شعار کوتاه بنویسید.\"}\n  ]\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "7c1f7a52-1d1e-4a57-9a8e-1f0d3f2b0a02",
      "name": "NetArz AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "NetArz AI key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7c1f7a52-1d1e-4a57-9a8e-1f0d3f2b0a04",
              "name": "answer",
              "value": "={{ $json.choices[0].message.content }}",
              "type": "string"
            },
            {
              "id": "7c1f7a52-1d1e-4a57-9a8e-1f0d3f2b0a05",
              "name": "request_id",
              "value": "={{ $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "7c1f7a52-1d1e-4a57-9a8e-1f0d3f2b0a03",
      "name": "Answer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Manual trigger": {
      "main": [[{ "node": "NetArz AI", "type": "main", "index": 0 }]]
    },
    "NetArz AI": {
      "main": [[{ "node": "Answer", "type": "main", "index": 0 }]]
    }
  },
