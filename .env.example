# Copy to .env (never commit .env). Create the key at https://netarz.ir/ai
NETARZ_API_KEY=sk-ntz-v1-your-key-here

# Optional overrides
NETARZ_BASE_URL=https://netarz.ir/api/ai/v1
NETARZ_MODEL=gpt-4o-mini

# telegram-bot/ only
TELEGRAM_BOT_TOKEN=

# The official OpenAI SDKs also read these two, so existing code can switch with no edits:
# OPENAI_API_KEY=sk-ntz-v1-your-key-here
# OPENAI_BASE_URL=https://netarz.ir/api/ai/v1
